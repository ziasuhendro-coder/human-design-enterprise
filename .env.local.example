# ============================================================================
# HUMAN DESIGN ENTERPRISE - Environment Variables
# ============================================================================
# Salin file ini jadi ".env.local" untuk pengembangan lokal, atau isi
# nilai yang sama di Vercel -> Project Settings -> Environment Variables.
#
# JANGAN PERNAH commit file ".env.local" berisi nilai asli ke Git.
# ============================================================================

# Diambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# "anon" / "publishable" key -- AMAN untuk exposed ke browser (dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# "service_role" key -- RAHASIA MUTLAK. Hanya dipakai di Server Actions/Edge
# Functions yang butuh bypass RLS (mis. promosi role, admin action).
# JANGAN PERNAH beri prefix NEXT_PUBLIC_ pada variabel ini -- kalau diberi
# prefix itu, Next.js akan membocorkannya ke bundle JavaScript sisi browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# URL aplikasi production, dipakai untuk redirect link konfirmasi email.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
